# Configuracion general de la aplicacion
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=webcantabra-secret-key

# Base de datos MySQL para XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_cantabra
DB_USER=root
DB_PASSWORD=

# Si no tienes MySQL levantado todavia, activa el modo demo para ver el diseno
DEMO_MODE=true
